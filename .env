# --- Application ---
APP_NAME=SecureAuth
APP_VERSION=1.0.0
DEBUG=True
AUTO_CREATE_TABLES=True

# --- Database ---
DATABASE_URL=sqlite:///./secureauth.db

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CHALLENGE_TOKEN_EXPIRE_MINUTES=5

# --- Two-factor authentication ---
TOTP_ISSUER_NAME=SecureAuth
TOTP_DIGITS=6
TOTP_INTERVAL=30
TOTP_WINDOW=1
BACKUP_CODES_COUNT=10

# --- Brute-force protection ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=atanasikafuka@gmail.com
MAIL_PASSWORD=eaiexpmmkpmrcsih
MAIL_FROM=atanasikafuka@gmail.com
MAIL_USE_TLS=True
MAIL_USE_SSL=False
