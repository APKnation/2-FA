
# --- Application ---
APP_NAME=SecureAuth
APP_VERSION=1.0.0
DEBUG=False
# Set to False when managing the schema with Alembic.
AUTO_CREATE_TABLES=True

# --- Database ---
# PostgreSQL example (recommended for production):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/secureauth
# Local development with SQLite:
# DATABASE_URL=sqlite:///./secureauth.db

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPI_DAYS=7
CHALLENGE_TOKEN_EXPIRE_MINUTES=5

# --- Two-factor authentication ---
TOTP_ISSUER_NAME=SecureAuth
TOTP_DIGITS=6
TOTP_INTERVAL=30
TOTP_WINDOW=1
BACKUP_CODES_COUNT=10

# --- Brute-force protection ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- CORS ---
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email (SMTP) — sends the 2FA verification code to the registered email ---
# Leave empty to disable email delivery (users then sign in with their app only).
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=smtp-user
# MAIL_PASSWORD=smtp-pass
# MAIL_FROM=noreply@secureauth.local
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
